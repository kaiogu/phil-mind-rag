# Copy to .env and fill in your values
# cp .env.example .env

# --- Generation ------------------------------------------------------------
# Required: choose one: <openai|openrouter>
LLM_PROVIDER=<openai|openrouter>

# --- OpenAI ----------------------------------------------------------------
# Required when LLM_PROVIDER=openai, EMBEDDING_PROVIDER=openai, or OpenAI web search is enabled
OPENAI_API_KEY=<your-openai-api-key>

# Optional. Default: gpt-5-mini
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_WEB_SEARCH_MODEL=gpt-5-mini

# --- OpenRouter ------------------------------------------------------------
# Required when LLM_PROVIDER=openrouter or EMBEDDING_PROVIDER=openrouter_free_auto
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Optional. Defaults shown below.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=openrouter/free

# --- Embeddings ------------------------------------------------------------
# Required: choose one: <openai|sentence_transformers|openrouter_free_auto>
EMBEDDING_PROVIDER=<openai|sentence_transformers|openrouter_free_auto>

# Optional. Required only by the selected embedding backend.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# SENTENCE_TRANSFORMERS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENROUTER_EMBEDDING_MODEL_PREFERENCES=qwen/qwen3-embedding-0.6b,voyage/voyage-3-lite,openai/text-embedding-3-small

# Optional
# OPENALEX_EMAIL=<you@example.com>

# --- ChromaDB --------------------------------------------------------------
# Optional. Defaults shown below.
# CHROMA_PERSIST_DIR=data/chroma
# CHROMA_COLLECTION_NAME=phil_mind_papers

# --- Ingestion -------------------------------------------------------------
# Optional. Defaults shown below.
# MAX_DOCUMENT_SIZE_MB=50
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# SOURCE_DOWNLOAD_DIR=data/raw/discovered

# --- App -------------------------------------------------------------------
# Optional. Defaults shown below.
# GRADIO_SERVER_PORT=7860
# LOG_LEVEL=INFO

# Recommended profiles
#
# Local quality profile:
#   LLM_PROVIDER=openai
#   EMBEDDING_PROVIDER=openai
#
# HF demo profile:
#   LLM_PROVIDER=openrouter
#   OPENROUTER_CHAT_MODEL=openrouter/free
#   EMBEDDING_PROVIDER=openrouter_free_auto
